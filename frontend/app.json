{
  "expo": {
    "name": "InvestorFlip",
    "slug": "investorflip",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/investorflip-icon.png",
    "scheme": "investorflip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bdenefowler.investorflip",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/investorflip-icon.png",
        "backgroundColor": "#031225"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/investorflip-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#031225"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7f7f2c5-4046-4648-90aa-286fcf1a549d"
      }
    },
    "owner": "britacuss-team"
  }
}
